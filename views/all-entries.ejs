<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <%- include('./partials/navbar') %>
    <h1>All Journals</h1>
    <% for(let OneEntry of entries){ %>
    <h3> title: <%= OneEntry.title %> </h3>
    <p> <%= OneEntry.entryBody %> </p>
    <% if(user._id == OneEntry.owner){%> 
        <a href="/entries/<%= OneEntry._id%>/edit">Edit</a>
        <form action="/entries/<%= OneEntry._id %>?_method=DELETE" method="POST">
        <button type="=submit">Delete</button>
        </form>
    <% }  %>
    <% } %>
    
</body>
</html>